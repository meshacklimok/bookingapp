# Secrets for Edge Functions. Copy to supabase/.env (git-ignored) and push with:
#   supabase secrets set --env-file supabase/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.

# M-Pesa (Safaricom Daraja). MPESA_ENV: sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till; also set MPESA_PARTY_B to the till number)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Any long random string. It is appended to the callback URL so only Safaricom's callback is accepted.
MPESA_CALLBACK_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
